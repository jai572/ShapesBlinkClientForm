# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin console PIN gate. ADMIN_EMAIL/ADMIN_PASSWORD must match a real
# Supabase Auth user (Authentication -> Users) - the PIN just fronts it.
ADMIN_PIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Emailing relocation sign-ups from /relocation/contacts (sent via the salon's
# Gmail with an app password: Google Account > Security > 2-Step Verification
# > App passwords). Set these in Vercel, never in the repo.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
